APP_NAME="INN Group"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Australia/Sydney
APP_URL=http://inngroup.test

# Multi-domain routing (production)
DOMAIN_MAIN=inngroup.com.au
DOMAIN_TAX=innovativetax.inngroup.com.au
DOMAIN_LOAN=innovativefinance.inngroup.com.au
DOMAIN_ADVISORY=innovativeadvisory.inngroup.com.au

# Path-based local URLs (when DOMAIN_ROUTING=false)
PATH_PREFIX_TAX=innovativetax
PATH_PREFIX_LOAN=innovativefinance
PATH_PREFIX_ADVISORY=innovativeadvisory

# Set true to force subdomain routing; false for path-based local URLs.
# Auto-disabled on localhost / 127.0.0.1 when unset.
# DOMAIN_ROUTING=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inngroup
DB_USERNAME=root
DB_PASSWORD=

# Use "file" for local dev when MySQL is not running; "database" in production if preferred
SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file

# sync = send emails immediately (recommended for local)
# database = run php artisan queue:work in a second terminal
QUEUE_CONNECTION=sync

# log = writes to storage/logs/laravel.log (testing)
# smtp = real inbox (Gmail, Mailtrap, etc.)
# log = preview in storage/logs only | smtp = real emails (Gmail app password recommended)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your.real.email@gmail.com
MAIL_PASSWORD=your16charapppassword
MAIL_ENCRYPTION=tls
# Must match MAIL_USERNAME when using Gmail SMTP (reduces spam folder placement)
MAIL_FROM_ADDRESS="your.real.email@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_COMPANY_NAME="INN Group"
MAIL_COMPANY_ADDRESS="Australia"
MAIL_COMPANY_WEBSITE="https://inngroup.com.au"

# Your inbox when someone submits a contact form
ADMIN_NOTIFICATION_EMAIL=aryanchaulagain35@gmail.com
# true = notify admin during form submit (recommended on Windows/local)
MAIL_SEND_ADMIN_IMMEDIATELY=true
# false = send emails in-process, not via queue worker
MAIL_QUEUE_NOTIFICATIONS=false
MAIL_SUPPORT_ADDRESS="hello@inngroup.com.au"
MAIL_SUPPORT_PHONE="+61 2 0000 0000"

VITE_APP_NAME="${APP_NAME}"
